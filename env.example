# Copy to .env for local Vite: cp env.example .env
#
# --- Allow anyone with Microsoft OR any Azure AD org (recommended quick setup) ---
# Register app as "Accounts in any org directory + personal Microsoft accounts"
# Authority must be /common (not a single tenant GUID).
# VITE_MSAL_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/common
#
# --- Optional: Entra External ID / Azure AD B2C (Google + email policies, etc.) ---
# VITE_MSAL_AUTHORITY=https://YOUR_TENANT.b2clogin.com/YOUR_TENANT.onmicrosoft.com/B2C_1_signupsignin
# VITE_MSAL_AUTHORITY_SIGNUP=https://YOUR_TENANT.b2clogin.com/YOUR_TENANT.onmicrosoft.com/B2C_1_signup
